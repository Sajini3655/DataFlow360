# Copy this file to .env and replace each placeholder before starting Compose.
# Use URL-safe characters for database passwords used in connection URLs.
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=dataflow

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_DB_NAME=airflow

AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me-airflow-ui
PIPELINE_INTERNAL_TOKEN=change-me-generate-a-long-random-token
DBT_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# Optional Azure Data Lake Storage Gen2 adapter.
# Local mode remains the default; Azure mode uses DefaultAzureCredential (Entra ID).
CLOUD_STORAGE_MODE=local
CLOUD_LOCAL_ROOT=/app/data/cloud
INSTALL_AZURE_SDK=false
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_AUTH_MODE=entra
AZURE_STORAGE_RETRY_TOTAL=3
AZURE_STORAGE_BRONZE_CONTAINER=dataflow-bronze
AZURE_STORAGE_SILVER_CONTAINER=dataflow-silver
AZURE_STORAGE_GOLD_CONTAINER=dataflow-gold
# Optional DefaultAzureCredential environment identity for containerized local development.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional Microsoft Fabric labels; setting these does not connect or execute a notebook.
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_NAME=
