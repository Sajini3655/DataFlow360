# Copy to .env.deploy and use:
# docker compose --env-file .env.deploy -f compose.deploy.yml up --build -d
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
POSTGRES_DB=dataflow
PIPELINE_INTERNAL_TOKEN=replace-with-long-random-secret

# Public HTTPS origin for browser requests, served by your separately managed reverse proxy.
PUBLIC_API_URL=https://api.example.invalid
CORS_ORIGINS=https://dataflow.example.invalid
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Optional Airflow API credentials. Leave blank to disable pipeline triggering.
AIRFLOW_API_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=

CLOUD_STORAGE_MODE=local
CLOUD_LOCAL_ROOT=/app/data/cloud
