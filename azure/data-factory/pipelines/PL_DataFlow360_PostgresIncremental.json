{
  "name": "PL_DataFlow360_PostgresIncremental",
  "properties": {
    "description": "Reads the stored PostgreSQL watermark, copies a bounded delta to ADLS, then advances the watermark only after the copy succeeds.",
    "concurrency": 1,
    "parameters": {
      "pipelineName": { "type": "String", "defaultValue": "DataFlow360-sales" },
      "schemaName": { "type": "String", "defaultValue": "public" },
      "tableName": { "type": "String", "defaultValue": "sales" },
      "watermarkColumn": { "type": "String", "defaultValue": "updated_at" },
      "targetFileSystem": { "type": "String", "defaultValue": "dataflow-bronze" },
      "targetFolder": { "type": "String", "defaultValue": "sales/incremental" }
    },
    "activities": [
      {
        "name": "GetWatermark",
        "type": "Script",
        "linkedServiceName": {
          "referenceName": "ls_postgresql_v2",
          "type": "LinkedServiceReference",
          "parameters": {
            "server": "REPLACE_POSTGRES_SERVER",
            "database": "REPLACE_DATABASE",
            "username": "REPLACE_READONLY_USERNAME"
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('SELECT COALESCE((SELECT watermark_value FROM dataflow_control.adf_watermarks WHERE pipeline_name = ''', pipeline().parameters.pipelineName, '''), TIMESTAMPTZ ''1970-01-01 00:00:00+00'') AS watermark_value')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:05:00"
        },
        "policy": { "timeout": "00:10:00", "retry": 2, "retryIntervalInSeconds": 15 }
      },
      {
        "name": "GetCurrentWatermark",
        "type": "Script",
        "dependsOn": [{ "activity": "GetWatermark", "dependencyConditions": ["Succeeded"] }],
        "linkedServiceName": {
          "referenceName": "ls_postgresql_v2",
          "type": "LinkedServiceReference",
          "parameters": {
            "server": "REPLACE_POSTGRES_SERVER",
            "database": "REPLACE_DATABASE",
            "username": "REPLACE_READONLY_USERNAME"
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('SELECT COALESCE(MAX(', pipeline().parameters.watermarkColumn, '), TIMESTAMPTZ ''1970-01-01 00:00:00+00'') AS current_watermark FROM ', pipeline().parameters.schemaName, '.', pipeline().parameters.tableName)",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:05:00"
        },
        "policy": { "timeout": "00:10:00", "retry": 2, "retryIntervalInSeconds": 15 }
      },
      {
        "name": "CopyIncrementalPostgresql",
        "type": "Copy",
        "dependsOn": [{ "activity": "GetCurrentWatermark", "dependencyConditions": ["Succeeded"] }],
        "policy": { "timeout": "02:00:00", "retry": 3, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "source": {
            "type": "PostgreSqlV2Source",
            "query": {
              "value": "@concat('SELECT * FROM ', pipeline().parameters.schemaName, '.', pipeline().parameters.tableName, ' WHERE ', pipeline().parameters.watermarkColumn, ' > ''', activity('GetWatermark').output.resultSets[0].rows[0].watermark_value, ''' AND ', pipeline().parameters.watermarkColumn, ' <= ''', activity('GetCurrentWatermark').output.resultSets[0].rows[0].current_watermark, '''')",
              "type": "Expression"
            }
          },
          "sink": { "type": "ParquetSink", "storeSettings": { "type": "AzureBlobFSWriteSettings" }, "formatSettings": { "type": "ParquetWriteSettings" } }
        },
        "inputs": [
          {
            "referenceName": "ds_postgresql_source",
            "type": "DatasetReference",
            "parameters": {
              "schemaName": { "value": "@pipeline().parameters.schemaName", "type": "Expression" },
              "tableName": { "value": "@pipeline().parameters.tableName", "type": "Expression" }
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_parquet_sink",
            "type": "DatasetReference",
            "parameters": {
              "fileSystem": { "value": "@pipeline().parameters.targetFileSystem", "type": "Expression" },
              "folderPath": { "value": "@pipeline().parameters.targetFolder", "type": "Expression" },
              "fileName": {
                "value": "@concat('sales_', formatDateTime(activity('GetWatermark').output.resultSets[0].rows[0].watermark_value, 'yyyyMMddHHmmss'), '_', formatDateTime(activity('GetCurrentWatermark').output.resultSets[0].rows[0].current_watermark, 'yyyyMMddHHmmss'), '.parquet')",
                "type": "Expression"
              }
            }
          }
        ]
      },
      {
        "name": "AdvanceWatermark",
        "type": "Script",
        "dependsOn": [{ "activity": "CopyIncrementalPostgresql", "dependencyConditions": ["Succeeded"] }],
        "linkedServiceName": {
          "referenceName": "ls_postgresql_v2",
          "type": "LinkedServiceReference",
          "parameters": {
            "server": "REPLACE_POSTGRES_SERVER",
            "database": "REPLACE_DATABASE",
            "username": "REPLACE_WATERMARK_WRITER_USERNAME"
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "@concat('INSERT INTO dataflow_control.adf_watermarks(pipeline_name, watermark_value) VALUES (''', pipeline().parameters.pipelineName, ''', ''', activity('GetCurrentWatermark').output.resultSets[0].rows[0].current_watermark, '''::timestamptz) ON CONFLICT (pipeline_name) DO UPDATE SET watermark_value = GREATEST(dataflow_control.adf_watermarks.watermark_value, EXCLUDED.watermark_value), updated_at = now()')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:05:00"
        },
        "policy": { "timeout": "00:10:00", "retry": 3, "retryIntervalInSeconds": 30 }
      }
    ],
    "annotations": ["DataFlow360", "Incremental", "Bronze"]
  }
}
